POSTGRES_DB=ecommerce_analytics
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_HOST=localhost
# Host port; change it if another project already uses 5432.
POSTGRES_PORT=5432

REDIS_PASSWORD=replace_with_local_password
REDIS_HOST=localhost
# Host port; change it if another project already uses 6379.
REDIS_PORT=6379

MONGO_INITDB_ROOT_USERNAME=ecommerce_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_local_password
# Host port; keep it in sync with the port in MONGO_URI.
MONGO_PORT=27017

MONGO_URI=mongodb://ecommerce_admin:replace_with_local_password@localhost:27017/?authSource=admin
MONGO_DATABASE=ecommerce_analytics
